---
interface Feature {
  title: string;
  text: string;
  /** Stroke path data for a 24×24 icon. */
  icon: string;
}

const features: Feature[] = [
  {
    title: 'Both directions',
    text: 'Upload from the phone, or download to it. Several files or a whole folder arrive as one ZIP.',
    icon: 'M7 4v16m0-16-4 4m4-4 4 4m6 12V4m0 16-4-4m4 4 4-4',
  },
  {
    title: 'No app needed',
    text: 'Any phone browser works. Nothing to install from an app store, no account to create.',
    icon: 'M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm3 16h2',
  },
  {
    title: 'Files stay local',
    text: 'Files go straight from one device to the other over your network. No cloud in between.',
    icon: 'M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1V9.5Z',
  },
  {
    title: 'Private by default',
    text: 'Every QR code carries a new access token, so only devices that scan it can connect.',
    icon: 'M6 11V8a6 6 0 1 1 12 0v3M5 11h14v10H5V11Zm7 4v2',
  },
  {
    title: 'Made for big files',
    text: 'Three uploads run in parallel with progress. A cancelled upload leaves nothing behind.',
    icon: 'M12 3v12m0 0-5-5m5 5 5-5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2',
  },
  {
    title: 'One small binary',
    text: 'A single executable for macOS and Linux, on Apple Silicon, Intel, x64, and arm64.',
    icon: 'm21 8-9-5-9 5 9 5 9-5Zm0 0v8l-9 5m-9-13v8l9 5m0-8v8',
  },
];
---

<section class="band">
  <div class="container section">
    <div class="section-intro">
      <span class="eyebrow">Why qrup</span>
      <h2>AirDrop for every phone and every computer</h2>
      <p>
        Android or iPhone, Mac or Linux: if both are on the same network, qrup gets the file across.
      </p>
    </div>

    <ul>
      {
        features.map((feature: Feature) => (
          <li class="card">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={feature.icon} />
            </svg>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .band {
    background: var(--bg-raised);
    border-block: 1px solid var(--border);
  }

  .band .card {
    background: var(--bg);
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  svg {
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.55rem;
    margin-bottom: 1rem;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  h3 {
    font-size: 1.1rem;
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
  }
</style>
