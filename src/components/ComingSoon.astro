---
import { repoUrl } from '../site';

interface Teaser {
  platform: string;
  text: string;
}

const teasers: Teaser[] = [
  {
    platform: 'Android & iPhone',
    text: 'Host qrup on your phone, even over its own hotspot, and share with any device nearby. Send from the share sheet.',
  },
  {
    platform: 'Mac',
    text: 'A menu bar app: start sharing with one click, no terminal needed.',
  },
];
---

<section class="container section">
  <div class="panel">
    <div class="intro">
      <span class="badge">Coming soon</span>
      <h2>qrup apps for your phone and your Mac</h2>
      <p>
        The command line stays free and open source. The apps add what a browser page can't do.
      </p>
      <a class="follow" href={`${repoUrl}/releases`}>Follow releases on GitHub →</a>
    </div>

    <ul>
      {
        teasers.map((teaser: Teaser) => (
          <li>
            <h3>{teaser.platform}</h3>
            <p>{teaser.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section {
    padding-bottom: 0;
  }

  .panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 100% 0%, var(--accent-soft), transparent 60%), var(--bg-raised);
  }

  .panel > * {
    min-width: 0;
  }

  .badge {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .intro p {
    margin: 0.75rem 0 1.25rem;
    color: var(--text-muted);
  }

  .follow {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .follow:hover {
    text-decoration: underline;
  }

  ul {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
  }

  h3 {
    font-size: 1.05rem;
  }

  li p {
    margin: 0.4rem 0 0;
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .panel {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>
