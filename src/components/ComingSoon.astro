---
import { repoUrl } from '../site';
---

<section id="apps" class="container section">
  <div class="panel">
    <span class="badge">Coming soon</span>
    <h2>qrup for Android and iPhone</h2>
    <p>Mobile apps are on the way. The command line stays free and open source.</p>
    <a class="follow" href={`${repoUrl}/releases`}>Follow releases on GitHub →</a>
  </div>
</section>

<style>
  .section {
    padding-bottom: 0;
  }

  .panel {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 100% 0%, var(--accent-soft), transparent 60%), var(--bg-raised);
    text-align: center;
  }

  .badge {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  p {
    margin: 0.75rem auto 1.25rem;
    max-width: 34rem;
    color: var(--text-muted);
  }

  .follow {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .follow:hover {
    text-decoration: underline;
  }
</style>
