---
interface Props {
  command: string;
}

const { command }: Props = Astro.props;
---

<div class="copy-command">
  <code><span class="prompt" aria-hidden="true">$</span> {command}</code>
  <button type="button" data-copy={command} aria-label={`Copy ${command}`}>Copy</button>
</div>

<style>
  .copy-command {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    background: var(--code-bg);
    color: #e8eaf2;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .prompt {
    color: #8088a3;
    user-select: none;
  }

  button {
    flex-shrink: 0;
    min-width: 5.5rem;
    padding: 0.55rem 0.9rem;
    border: 0;
    border-radius: 8px;
    background: var(--accent-strong);
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  button:hover {
    background: var(--accent);
  }
</style>

<script>
  const resetDelayMs = 1800;

  async function copyCommand(button: HTMLButtonElement): Promise<void> {
    const command: string = button.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(command);
      button.textContent = 'Copied';
    } catch {
      button.textContent = 'Select it';
    }
    setTimeout((): void => {
      button.textContent = 'Copy';
    }, resetDelayMs);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.addEventListener('click', (): void => {
      void copyCommand(button);
    });
  }
</script>
